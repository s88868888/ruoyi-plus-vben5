                          :fetch-suggestions="
                            (queryString, cb) => handleSuggestions(queryString, cb, item)
                          "
                          :placeholder="item.placeholder || '请输入，支持搜索建议'"
                          clearable
                          class="condition-input"
                        />
                      </div>
                    </div>
                  </template>

                  <!-- 标签类筛选 -->
                  <template v-else-if="activeCategory === 'tags'">
                    <div v-if="labelList.length === 0" class="empty-state">
                      <el-icon class="empty-icon"><Document /></el-icon>
                      <div class="empty-text">暂无标签信息</div>
                      <div class="empty-desc">请联系管理员配置标签</div>
                    </div>
                    <div v-else class="tags-content">
                      <template v-for="group in groupedLabels" :key="group.type">
                        <div v-if="group.labels.length" class="tag-group">
                          <div class="group-title">{{ group.title }}</div>
                          <div class="tag-list">
                            <div
                              v-for="item in group.labels"
                              :key="item.id"
                              :class="['tag-item', { selected: selectedTagIds.includes(item.id) }]"
                              @click="handleTagToggle(item)"
                            >
                              {{ item.name }}
                            </div>
                          </div>
                        </div>
                      </template>
                    </div>
                  </template>

                  <!-- 自定义筛选 -->
                  <!-- 已移除自定义筛选分类，所有筛选条件都归入时间、选择、数值三个类别 -->
                </div>
                <div v-else class="empty-state">
                  <el-icon class="empty-icon"><Document /></el-icon>
                  <div class="empty-text">该类型暂无筛选条件</div>
                </div>
              </div>

              <!-- 已选条件列 -->
              <div class="selected-panel">
                <div class="panel-title">已选条件</div>
                <div class="selected-list">
                  <!-- 已选标签 -->
                  <template v-if="tempSelectedTags.length">
                    <div class="selected-group">
                      <div class="group-title">标签</div>
                      <div class="selected-items">
                        <div v-for="tag in tempSelectedTags" :key="tag.id" class="selected-item">
                          <el-tooltip
                            :content="tag.name"
                            placement="top"
                            :disabled="tag.name.length <= 15"
                          >
                            <span class="item-text">{{ tag.name }}</span>
                          </el-tooltip>
                          <el-icon class="remove-icon" @click.stop="removeTag(tag)">
                            <Close />
                          </el-icon>
                        </div>
                      </div>
                    </div>
                  </template>

                  <!-- 已选筛选条件 -->
                  <template v-if="previewConditions.length">
                    <div
                      v-for="group in groupedPreviewConditions"
                      :key="group.category"
                      class="selected-group"
                    >
                      <div class="group-title">{{ group.title }}</div>
                      <div class="selected-items">
                        <div
                          v-for="condition in group.items"
                          :key="condition.field"
                          class="selected-item"
                        >
                          <el-tooltip
                            :content="`${condition.label}: ${getConditionDisplayValue(condition)}`"
                            placement="top"
                            :disabled="!isTextOverflow(condition)"
                          >
                            <span class="item-text">
                              {{ condition.label }}:
                              {{ getConditionDisplayValue(condition) }}
                            </span>
                          </el-tooltip>
                          <el-icon
                            class="remove-icon"
                            @click.stop="removePreviewCondition(condition)"
                          >
                            <Close />
                          </el-icon>
                        </div>
                      </div>
                    </div>
                  </template>

                  <!-- 空状态 -->
                  <div
                    v-if="!tempSelectedTags.length && !previewConditions.length"
                    class="empty-state"
                  >
                    <el-icon class="empty-icon"><Filter /></el-icon>
                    <div class="empty-text">暂无已选条件</div>
                  </div>
                </div>
              </div>
