          <!-- 底部固定操作区 -->
          <div class="filter-footer">
            <div class="footer-left">
              <el-button @click="handlePreviewClear">重置条件</el-button>
            </div>
            <div class="footer-right">
              <el-button @click="handleCancel">取消</el-button>
              <el-button type="primary" @click="handleConfirm">应用条件</el-button>
            </div>
          </div>
        </div>
      </template>
    </el-popover>

    <!-- 已选条件展示区域 -->
    <div class="selected-conditions" ref="conditionsContainer" v-if="hasActiveFilters">
      <!-- 已选标签 -->
      <template v-if="selectedTags.length">
        <div
          v-for="tag in selectedTags"
          :key="tag.id"
          class="condition-item"
          @click="removeSelectedTag(tag)"
        >
          <el-tooltip :content="tag.name" placement="top" :disabled="tag.name.length <= 12">
            <span class="condition-text">{{ tag.name }}</span>
          </el-tooltip>
          <el-icon class="close-icon"><Close /></el-icon>
        </div>
      </template>

      <!-- 已选筛选条件 -->
      <template v-if="selectedConditions.length">
        <div
          v-for="condition in visibleConditions"
          :key="condition.id"
          class="condition-item"
          @click="removeCondition(condition)"
        >
          <el-tooltip
            :content="`${condition.label}: ${getConditionValue(condition)}`"
            placement="top"
            :disabled="!isExternalTextOverflow(condition)"
          >
            <span class="condition-text"
              >{{ condition.label }}: {{ getConditionValue(condition) }}</span
            >
          </el-tooltip>
          <el-icon class="close-icon"><Close /></el-icon>
        </div>

        <!-- 溢出展示 -->
        <el-popover
          v-if="hiddenConditions.length"
          placement="bottom-end"
          trigger="click"
          :width="300"
        >
          <template #reference>
            <div class="condition-item more-conditions">
              <span class="condition-text">更多 +{{ hiddenConditions.length }}</span>
              <el-icon><ArrowDown /></el-icon>
            </div>
          </template>
          <div class="hidden-conditions">
            <div
              v-for="condition in hiddenConditions"
              :key="condition.id"
              class="condition-item"
              @click="removeCondition(condition)"
            >
              <el-tooltip
                :content="`${condition.label}: ${getConditionValue(condition)}`"
                placement="top"
              >
                <span class="condition-text"
                  >{{ condition.label }}: {{ getConditionValue(condition) }}</span
                >
