<script setup lang="ts">
import { ref, computed, onMounted, watch, nextTick, onUnmounted } from 'vue'
import { nanoid } from 'nanoid'
import elementResizeDetectorMaker from 'element-resize-detector'
import { ArrowDown, Close, Document, Filter, Star } from '@element-plus/icons-vue'
import { Icon } from '@iconify/vue'
import { getLabelList } from '@/api/label'
import { useUserStore } from '@/store/modules/user'
import dayjs from 'dayjs'
import _ from 'lodash'

interface LabelItem {
  id: string
  name: string
  objtype: string
  isglobal: string
  ispublic: string
  createuserid: string
  [key: string]: any
}

interface FilterCategory {
  key: string
  label: string
  icon: any
  iconType?: 'element' | 'iconify' // 新增图标类型标识
  count: number
  disabled: boolean
}

interface GroupedCondition {
  category: string
  title: string
  items: any[]
}

const props = defineProps({
  type: {
    type: String,
    default: 'both',
    validator: (value: string) => ['label', 'more', 'both'].includes(value)
  },
  objectType: {
    type: String,
    default: ''
  },
  filterData: {
    type: Array,
    default: () => []
  }
})

const emit = defineEmits(['update:selectedTags', 'handle-query', 'change'])

const userStore = useUserStore()
const popoverVisible = ref(false)
const conditionsContainer = ref(null)

// 筛选配置管理
interface FilterConfig {
  objectType: string
  commonFilters: string[]
  uncommonFilters: string[]
}

const filterConfig = ref<FilterConfig>({
  objectType: props.objectType,
  commonFilters: [],
  uncommonFilters: []
})

// 筛选类别管理
const activeCategory = ref('common')

// 标签相关状态
const labelList = ref<LabelItem[]>([])
const tempSelectedTags = ref<LabelItem[]>([])
const selectedTags = ref<LabelItem[]>([])
const selectedTagIds = ref<string[]>([])

// 更多筛选相关状态
const myFilterData = ref(JSON.parse(JSON.stringify(props.filterData)))
const selectedConditions = ref([])

// 动态高度计算
const dynamicHeight = computed(() => {
  const isMobile = window.innerWidth <= 768
  const maxHeight = isMobile ? 400 : 520
  const minHeight = isMobile ? 250 : 300

  const baseHeight = 80 // 底部操作区 + padding
  const headerHeight = 0 // 无顶部标题

  // 计算左侧筛选类型所需高度
  const categoriesCount = filterCategories.value.length
  const categoryTitleHeight = 45 // 筛选类型标题
  const sidebarHeight = Math.max(200, categoriesCount * 45 + categoryTitleHeight)

  // 计算中间筛选条件所需高度
  let conditionsHeight = 60 // 标题高度
  if (currentCategoryData.value.items.length > 0) {
    // 根据不同类型计算不同高度
    let itemHeight = 70 // 默认条件高度
    if (activeCategory.value === 'select') {
      // 选择类可能需要更多空间（radio/checkbox组）
      itemHeight = 90
    } else if (activeCategory.value === 'text') {
      // 文本类可能需要更多空间（textarea）
      itemHeight = 80
    }
    conditionsHeight += currentCategoryData.value.items.length * itemHeight
  } else {
    conditionsHeight += 200 // 空状态高度
  }

  // 计算右侧已选条件所需高度
  let selectedHeight = 60 // 标题高度
  const totalSelectedItems = tempSelectedTags.value.length + previewConditions.value.length
  if (totalSelectedItems > 0) {
    selectedHeight += totalSelectedItems * 35 + Math.ceil(totalSelectedItems / 5) * 20 // 考虑分组间距
  } else {
    selectedHeight += 200 // 空状态高度
  }

  // 取最大值作为内容高度
  const contentHeight = Math.max(sidebarHeight, conditionsHeight, selectedHeight)
  const totalHeight = contentHeight + baseHeight + headerHeight

  // 限制在最小和最大高度之间
  return Math.max(minHeight, Math.min(maxHeight, totalHeight))
})

// 筛选类别配置（优化版）
const filterCategories = computed<FilterCategory[]>(() => {
  const categories = []

  // 根据type属性决定显示哪些类别
  if (props.type === 'more' || props.type === 'both') {
    // 常用条件
    if (categorizedFilterData.value.common.length > 0) {
      categories.push({
        key: 'common',
        label: '常用条件',
        icon: Star,
        iconType: 'element',
        count: categorizedFilterData.value.common.length,
        disabled: false
      })
    }

    // 其他条件
    if (categorizedFilterData.value.uncommon.length > 0) {
      categories.push({
        key: 'uncommon',
        label: '其他条件',
        icon: 'mdi:dots-grid',
        iconType: 'iconify',
        count: categorizedFilterData.value.uncommon.length,
        disabled: false
      })
    }
  }

  if (props.type === 'label' || props.type === 'both') {
    // 标签筛选类别 - 只有在有对象类型时才显示
    if (props.objectType) {
      categories.push({
        key: 'tags',
        label: '标签条件',
        icon: 'mdi:tag-multiple',
        iconType: 'iconify',
        count: labelList.value.length,
        disabled: false
      })
    }
  }

  return categories
})

// 配置管理方法
const loadFilterConfig = () => {
  initDefaultConfig()
}

const initDefaultConfig = () => {
  const commonFilters: string[] = []
  const uncommonFilters: string[] = []

  props.filterData.forEach((item: any) => {
    if (item.isCommon !== false) {
      commonFilters.push(item.field)
    } else {
      uncommonFilters.push(item.field)
    }
  })

  filterConfig.value = {
    objectType: props.objectType,
    commonFilters,
    uncommonFilters
  }
}

// 根据field数组获取筛选项
const getFilterItemsByFields = (fields: string[]) => {
  return fields
    .map((field) => myFilterData.value.find((item) => item.field === field))
    .filter((item) => item !== undefined)
}

// 按类型分类筛选数据（优化版 - 根据配置分类）
const categorizedFilterData = computed(() => {
  const data = {
    common: [],
    uncommon: [],
    time: [],
    select: [],
    number: [],
    text: []
  }

  // 根据配置分类常用和不常用
  data.common = getFilterItemsByFields(filterConfig.value.commonFilters)
  data.uncommon = getFilterItemsByFields(filterConfig.value.uncommonFilters)

  // 保留原有的类型分类逻辑（备用）
  myFilterData.value.forEach((item) => {
    if (item.type.includes('date-picker')) {
      data.time.push(item)
    } else if (
      item.type === 'el-select' ||
      item.type === 'el-select-more' ||
      item.type === 'el-radio' ||
      item.type === 'el-checkbox'
    ) {
      data.select.push(item)
    } else if (item.type === 'el-input-range') {
      data.number.push(item)
    } else if (
      item.type === 'el-input' ||
      item.type === 'el-textarea' ||
      item.type === 'el-autocomplete'
    ) {
      data.text.push(item)
    }
  })

  return data
})

// 当前活动类别的数据（优化版）
const currentCategoryData = computed(() => {
  const categoryData = {
    common: {
      items: categorizedFilterData.value.common,
      disabled: false
    },
    uncommon: {
      items: categorizedFilterData.value.uncommon,
      disabled: false
    },
    time: {
      items: categorizedFilterData.value.time,
      disabled: false
    },
    select: {
      items: categorizedFilterData.value.select,
      disabled: false
    },
    number: {
      items: categorizedFilterData.value.number,
      disabled: false
    },
    text: {
      items: categorizedFilterData.value.text,
      disabled: false
    },
    tags: { items: [], disabled: false }
  }

  return categoryData[activeCategory.value] || { items: [], disabled: false }
})

// 预览条件（用于实时显示已选条件）
const previewConditions = computed(() => {
  const conditions = []
  for (const item of myFilterData.value) {
    if (hasValue(item)) {
      conditions.push(item)
    }
  }
  return conditions
})

// 分组显示预览条件
const groupedPreviewConditions = computed<GroupedCondition[]>(() => {
  const groups: Record<string, GroupedCondition> = {}

  previewConditions.value.forEach((condition) => {
    const category = getCategoryByType(condition.type)
    if (!groups[category]) {
      groups[category] = {
        category,
        title: getCategoryTitle(category),
        items: []
      }
    }
    groups[category].items.push(condition)
  })

  return Object.values(groups)
})

// 控制条件显示
const containerWidth = ref(0)
const visibleConditions = computed(() => {
  if (!containerWidth.value) return selectedConditions.value

  let totalWidth = 0
  return selectedConditions.value.filter((condition) => {
    const estimatedWidth = (condition.label.length + getConditionValue(condition).length) * 12 + 50
    totalWidth += estimatedWidth
    return totalWidth < containerWidth.value - 100
  })
})

const hiddenConditions = computed(() => {
  return selectedConditions.value.filter(
    (condition) => !visibleConditions.value.includes(condition)
  )
})

const elPopoverFilterCardWrapDivFinalRef = ref(null)

// 工具函数
const hasValue = (item) => {
  if (typeof item.data === 'string' && item.data.trim() !== '') return true
  if (Array.isArray(item.data) && item.data.length > 0) return true
  if (item.type === 'el-input-range' && (item.data?.start || item.data?.end)) return true
  if (item.type.includes('range') && Array.isArray(item.data) && item.data.length === 2) return true
  if (item.type === 'el-input' && item.data.trim() !== '') return true
  if (item.type === 'el-textarea' && item.data.trim() !== '') return true
  if (item.type === 'el-autocomplete' && item.data.trim() !== '') return true
  return false
}

const getCategoryByType = (type) => {
  if (type.includes('date-picker')) return 'time'
  if (
    type === 'el-select' ||
    type === 'el-select-more' ||
    type === 'el-radio' ||
    type === 'el-checkbox'
  )
    return 'select'
  if (type === 'el-input-range') return 'number'
  if (type === 'el-input' || type === 'el-textarea' || type === 'el-autocomplete') return 'text'
  return 'tags'
}

const getCategoryTitle = (category) => {
  const titles = {
    time: '时间筛选',
    select: '选择筛选',
    number: '数值筛选',
    text: '文本筛选',
    tags: '标签筛选'
  }
  return titles[category] || '其他筛选'
}

// 类别选择
const selectCategory = (category: FilterCategory) => {
  activeCategory.value = category.key
}

// 标签操作
const handleTagToggle = (item: LabelItem) => {
  const index = selectedTagIds.value.indexOf(item.id)
  if (index > -1) {
    selectedTagIds.value.splice(index, 1)
    tempSelectedTags.value = tempSelectedTags.value.filter((tag) => tag.id !== item.id)
  } else {
    selectedTagIds.value.push(item.id)
    tempSelectedTags.value.push(item)
  }
}

// 获取条件显示值
const getConditionDisplayValue = (condition) => {
  return getConditionValue(condition)
}

// 移除预览条件
const removePreviewCondition = (condition) => {
  const targetItem = myFilterData.value.find((item) => item.field === condition.field)
  if (targetItem) {
    if (targetItem.type === 'el-checkbox' || targetItem.type === 'el-select-more') {
      targetItem.data = []
    } else if (targetItem.type === 'el-input-range') {
      targetItem.data = { start: '', end: '' }
    } else if (targetItem.type === 'el-input') {
      targetItem.data = ''
    } else if (targetItem.type === 'el-textarea') {
      targetItem.data = ''
    } else if (targetItem.type === 'el-autocomplete') {
      targetItem.data = ''
    } else {
      targetItem.data = ''
    }
  }
  // 注意：这里不调用 emitChange()，因为是在弹窗内的预览操作
}

const isPopoverChildComponent = (element, parent) => {
  if (element && element.classList) {
    // 检查是否是日期选择器的弹出层
    if (
      element.classList.contains('el-picker__popper') ||
      element.classList.contains('el-select__popper') ||
      element.classList.contains('ItemValueDataPickerPopoverVitualClass')
    ) {
      return true
    }
  }

  if (element === parent) {
    return true
  }
  if (element.parentElement) {
    return isPopoverChildComponent(element.parentElement, parent)
  }
  return false
}

const handleGlobalClick = (event) => {
  nextTick(() => {
    if (!isPopoverChildComponent(event.target, elPopoverFilterCardWrapDivFinalRef.value)) {
      popoverVisible.value = false
    }
  })
}

const registerGlobalClick = () => {
  window.addEventListener('click', handleGlobalClick)
}

const unregisterGlobalClick = () => {
  window.removeEventListener('click', handleGlobalClick)
}

// 标签分组
const groupTitles = {
  '0': '集团标签',
  '1': '公司标签',
  '2': '个人标签'
}

const groupedLabels = computed(() => {
  const groups = {
    '0': [],
    '1': [],
    '2': []
  }

  labelList.value.forEach((label) => {
    const groupKey = label.labelgroup
    if (groupKey in groups) {
      groups[groupKey].push(label)
    }
  })

  return Object.entries(groups)
    .map(([type, labels]) => ({
      type,
      title: groupTitles[type],
      labels
    }))
    .filter((group) => group.labels.length > 0)
})

// 添加日期快捷选项
const shortcuts = [
  {
    text: '今天',
    value: () => {
      const today = new Date()
      today.setHours(0, 0, 0, 0)
      const end = new Date(today)
      end.setHours(23, 59, 59, 999)
      return [today, end]
    }
  },
  {
    text: '昨天',
    value: () => {
      const yesterday = new Date()
      yesterday.setDate(yesterday.getDate() - 1)
      yesterday.setHours(0, 0, 0, 0)
      const end = new Date(yesterday)
      end.setHours(23, 59, 59, 999)
      return [yesterday, end]
    }
  },
  {
    text: '本周',
    value: () => {
      const end = new Date()
      const start = new Date()
      start.setDate(start.getDate() - start.getDay())
      start.setHours(0, 0, 0, 0)
      end.setDate(end.getDate() - end.getDay() + 6)
      end.setHours(23, 59, 59, 999)
      return [start, end]
    }
  },
  {
    text: '上周',
    value: () => {
      const end = new Date()
      const start = new Date()
      start.setDate(start.getDate() - start.getDay() - 7)
      start.setHours(0, 0, 0, 0)
      end.setDate(end.getDate() - end.getDay() - 1)
      end.setHours(23, 59, 59, 999)
      return [start, end]
    }
  },
  {
    text: '本月',
    value: () => {
      const end = new Date()
      const start = new Date()
      start.setDate(1)
      start.setHours(0, 0, 0, 0)
      end.setHours(23, 59, 59, 999)
      return [start, end]
    }
  },
  {
    text: '上个月',
    value: () => {
      const end = new Date()
      const start = new Date()
      start.setMonth(start.getMonth() - 1)
      start.setDate(1)
      start.setHours(0, 0, 0, 0)
      end.setMonth(end.getMonth(), 0)
      end.setHours(23, 59, 59, 999)
      return [start, end]
    }
  },
  {
    text: '下个月',
    value: () => {
      const start = new Date()
      const end = new Date()
      start.setMonth(start.getMonth() + 1)
      start.setDate(1)
      start.setHours(0, 0, 0, 0)
      end.setMonth(end.getMonth() + 2, 0)
      end.setHours(23, 59, 59, 999)
      return [start, end]
    }
  },
  {
    text: '本季度',
    value: () => {
      const end = new Date()
      const start = new Date()
      const month = start.getMonth()
      const quarterStartMonth = Math.floor(month / 3) * 3
      start.setMonth(quarterStartMonth, 1)
      start.setHours(0, 0, 0, 0)
      end.setMonth(quarterStartMonth + 3, 0)
      end.setHours(23, 59, 59, 999)
      return [start, end]
    }
  },
  {
    text: '上季度',
    value: () => {
      const end = new Date()
      const start = new Date()
      const month = start.getMonth()
      const quarterStartMonth = Math.floor(month / 3) * 3 - 3
      start.setMonth(quarterStartMonth, 1)
      start.setHours(0, 0, 0, 0)
      end.setMonth(quarterStartMonth + 3, 0)
      end.setHours(23, 59, 59, 999)
      return [start, end]
    }
  }
]

// 获取标签数据
const getLabelData = async () => {
  if (!props.objectType) {
    // 如果没有传递对象类型，不请求标签数据
    return
  }

  try {
    // 获取可选择的标签列表
    const res = await getLabelList({
      head: { requestId: '' },
      dic: [
        { key: 'txtEqual_objtype', value: props.objectType },
        { key: 'txtEqual_status', value: 1 }
      ],
      pageIndex: 1,
      pageSize: -1,
      orderFile: 'updatetime',
      sortType: 1
    })

    if (res.responseData && Array.isArray(res.responseData)) {
      labelList.value = res.responseData.filter(
        (label) =>
          label.isglobal === '1' ||
          label.ispublic === '1' ||
          label.createuserid === userStore.userInfo?.id
      )
    }
  } catch (error) {
    console.error('获取标签列表失败:', error)
  }
}

// 标签相关操作
const handleTagChange = (checked, item: LabelItem) => {
  if (checked) {
    if (!tempSelectedTags.value.find((tag) => tag.id === item.id)) {
      tempSelectedTags.value.push(item)
    }
  } else {
    tempSelectedTags.value = tempSelectedTags.value.filter((tag) => tag.id !== item.id)
  }
}

const removeTag = (tag: LabelItem) => {
  tempSelectedTags.value = tempSelectedTags.value.filter((item) => item.id !== tag.id)
  selectedTagIds.value = selectedTagIds.value.filter((id) => id !== tag.id)
  // 注意：这里也不调用 emitChange()，因为是在弹窗内的预览操作
}

const removeSelectedTag = (tag: LabelItem) => {
  selectedTags.value = selectedTags.value.filter((item) => item.id !== tag.id)
  tempSelectedTags.value = tempSelectedTags.value.filter((item) => item.id !== tag.id)
  selectedTagIds.value = selectedTagIds.value.filter((id) => id !== tag.id)
  emitChange()
}

// 更多筛选相关操作
const getDatePickerType = (type: string) => {
  switch (type) {
    case 'el-date-picker-year':
      return 'year'
    case 'el-date-picker-month':
      return 'month'
    case 'el-date-picker-start-end':
      return 'daterange'
    case 'el-date-picker-se-two':
      return 'datetimerange'
    default:
      return 'date'
  }
}

const getConditionValue = (condition) => {
  if (condition.type === 'el-select' || condition.type === 'el-radio') {
    return condition.options.find((opt) => opt.value === condition.data)?.label || condition.data
  } else if (condition.type === 'el-select-more' || condition.type === 'el-checkbox') {
    return condition.options
      .filter((opt) => condition.data.includes(opt.value))
      .map((opt) => opt.label)
      .join(',')
  } else if (condition.type === 'el-input-range') {
    return `${condition.data.start || 'N/A'} 至 ${condition.data.end || 'N/A'}`
  } else if (
    condition.type === 'el-date-picker-start-end' ||
    condition.type === 'el-date-picker-se-two'
  ) {
    return `${dayjs(condition.data[0]).format('YY-MM-DD')} 至 ${dayjs(condition.data[1]).format(
      'YY-MM-DD'
    )}`
  } else if (condition.type === 'el-date-picker-month-range') {
    return `${dayjs(condition.data[0]).format('YYYY-MM')} 至 ${dayjs(condition.data[1]).format(
      'YYYY-MM'
    )}`
  } else if (condition.type === 'el-date-picker-year-range') {
    return `${dayjs(condition.data[0]).format('YYYY')} 至 ${dayjs(condition.data[1]).format(
      'YYYY'
    )}`
  } else if (condition.type === 'el-input') {
    return condition.data
  } else if (condition.type === 'el-textarea') {
    return condition.data
  } else if (condition.type === 'el-autocomplete') {
    return condition.data
  }
  return condition.data
}

const isTextOverflow = (condition) => {
  const text = `${condition.label}: ${getConditionDisplayValue(condition)}`
  return text.length > 20 // 假设超过20个字符就认为溢出
}

const isExternalTextOverflow = (condition) => {
  const text = `${condition.label}: ${getConditionValue(condition)}`
  return text.length > 20 // 假设超过20个字符就认为溢出
}

const removeCondition = (condition) => {
  selectedConditions.value = selectedConditions.value.filter((c) => c.id !== condition.id)
  const targetItem = myFilterData.value.find((item) => item.field === condition.field)
  if (targetItem) {
    targetItem.data = targetItem.type === 'el-checkbox' ? [] : ''
  }
  emitChange()
}

// 通用操作
const handleClear = () => {
  tempSelectedTags.value = []
  selectedTags.value = []
  selectedTagIds.value = []
  selectedConditions.value = []
  myFilterData.value = JSON.parse(JSON.stringify(props.filterData))
  emitChange()
}

// 弹窗内的重置操作（不触发查询）
const handlePreviewClear = () => {
  // 清空临时选中的标签
  tempSelectedTags.value = []
  selectedTagIds.value = []

  // 重置所有筛选条件到初始状态
  myFilterData.value = JSON.parse(JSON.stringify(props.filterData)).map((item) => {
    if (item.type === 'el-input-range') {
      item.data = { start: '', end: '' }
    } else if (item.type === 'el-checkbox' || item.type === 'el-select-more') {
      item.data = []
    } else if (
      item.type === 'el-date-picker-start-end' ||
      item.type === 'el-date-picker-se-two' ||
      item.type === 'el-date-picker-month-range' ||
      item.type === 'el-date-picker-year-range'
    ) {
      item.data = []
    } else if (item.type === 'el-input') {
      item.data = ''
    } else if (item.type === 'el-textarea') {
      item.data = ''
    } else if (item.type === 'el-autocomplete') {
      item.data = ''
    } else {
      item.data = ''
    }
    return item
  })

  // 注意：这里不调用 emitChange()，因为是在弹窗内的预览操作
}

const handleCancel = () => {
  // 取消操作，恢复到上次确认的状态
  tempSelectedTags.value = [...selectedTags.value]
  selectedTagIds.value = selectedTags.value.map((tag) => tag.id)
  myFilterData.value = JSON.parse(JSON.stringify(props.filterData))
  popoverVisible.value = false
}

const handleConfirm = () => {
  // 处理标签
  selectedTags.value = [...tempSelectedTags.value]

  // 处理筛选条件
  const validConditions = []
  for (const item of myFilterData.value) {
    if (
      (typeof item.data === 'string' && item.data.trim() !== '') ||
      (Array.isArray(item.data) && item.data.length > 0) ||
      (item.type === 'el-input-range' && (item.data?.start || item.data?.end)) ||
      (item.type.includes('range') && Array.isArray(item.data) && item.data.length === 2) ||
      (item.type === 'el-input' && item.data.trim() !== '') ||
      (item.type === 'el-textarea' && item.data.trim() !== '') ||
      (item.type === 'el-autocomplete' && item.data.trim() !== '')
    ) {
      validConditions.push({
        ...item,
        id: nanoid()
      })
    }
  }
  selectedConditions.value = validConditions

  popoverVisible.value = false
  emitChange()
}

const handlePopoverClose = () => {
  handleConfirm()
}

const emitChange = () => {
  emit('update:selectedTags', selectedTags.value)

  const queryConditions = []

  // 处理标签查询条件 - 将选中的标签ID用逗号分割
  if (selectedTags.value.length > 0) {
    const tagIds = selectedTags.value.map((tag) => tag.id).join(',')
    queryConditions.push({
      key: 'label',
      value: tagIds
    })
  }

  // 处理其他筛选条件
  for (const item of selectedConditions.value) {
    queryConditions.push(...makeQueryKey(item))
  }

  emit('handle-query', queryConditions)

  emit('change', {
    tags: selectedTags.value,
    conditions: queryConditions
  })
}

const makeQueryKey = (item) => {
  const objs = []
  const obj = { key: '', value: '' }

  switch (item.type) {
    case 'el-select':
      obj.key = 'txtEqual_' + item.field
      obj.value = item.data
      objs.push(obj)
      break
    case 'el-select-more':
      obj.key = 'txtMult_' + item.field
      obj.value = item.data ? item.data.join(',') : ''
      objs.push(obj)
      break
    case 'el-radio':
    case 'el-date-picker':
    case 'el-date-picker-year':
    case 'el-date-picker-month':
      obj.key = 'txtEqual_' + item.field
      obj.value = item.data
      objs.push(obj)
      break
    case 'el-date-picker-start':
      obj.key = 'dtS_' + item.field
      obj.value = item.data
      objs.push(obj)
      break
    case 'el-date-picker-end':
      obj.key = 'dtE_' + item.field
      obj.value = item.data
      objs.push(obj)
      break
    case 'el-checkbox':
      obj.key = 'txtMult_' + item.field
      obj.value = item.data.join(',')
      objs.push(obj)
      break
    case 'el-date-picker-start-end':
      // 开始时间设置为当天的 00:00:00
      obj.key = 'dtS_' + item.field
      obj.value = item.data[0] ? dayjs(item.data[0]).format('YYYY-MM-DD 00:00:00') : ''
      objs.push(obj)
      // 结束时间设置为当天的 23:59:59
      const obj2 = {
        key: 'dtE_' + item.field,
        value: item.data[1] ? dayjs(item.data[1]).format('YYYY-MM-DD 23:59:59') : ''
      }
      objs.push(obj2)
      break
    case 'el-date-picker-month-range':
      obj.key = 'dtE_' + item.field
      obj.value = item.data[1]
      objs.push(obj)
      const obj3 = { key: 'dtS_' + item.field, value: item.data[0] }
      objs.push(obj3)
      break
    case 'el-date-picker-year-range':
      obj.key = 'dtE_' + item.field
      obj.value = item.data[1]
      objs.push(obj)
      const obj5 = { key: 'dtS_' + item.field, value: item.data[0] }
      objs.push(obj5)
      break
    case 'el-date-picker-se-two':
      obj.key = 'dtS_' + item.field
      obj.value = item.data[1]
      objs.push(obj)
      const obj4 = { key: 'dtE_' + item.field2, value: item.data[0] }
      objs.push(obj4)
      break
    case 'el-input-range':
      if (item.data && typeof item.data === 'object') {
        if (item.data.start) {
          objs.push({
            key: 'GreaterThanOrEqual_' + item.field,
            value: parseInt(item.data.start)
          })
        }
        if (item.data.end) {
          objs.push({
            key: 'LessThanOrEqual_' + item.field,
            value: parseInt(item.data.end)
          })
        }
      }
      break
    case 'el-input':
      if (item.data) {
        // 支持配置搜索模式: 'fuzzy'(模糊) 或 'exact'(精确，默认)
        const keyPrefix = item.searchMode === 'fuzzy' ? 'txt_' : 'txtEqual_'
        objs.push({
          key: keyPrefix + item.field,
          value: item.data
        })
      }
      break
    case 'el-textarea':
      if (item.data) {
        // 支持配置搜索模式: 'fuzzy'(模糊) 或 'exact'(精确，默认)
        const keyPrefix = item.searchMode === 'fuzzy' ? 'txt_' : 'txtEqual_'
        objs.push({
          key: keyPrefix + item.field,
          value: item.data
        })
      }
      break
    case 'el-autocomplete':
      if (item.data) {
        // 支持配置搜索模式: 'fuzzy'(模糊) 或 'exact'(精确，默认)
        const keyPrefix = item.searchMode === 'fuzzy' ? 'txt_' : 'txtEqual_'
        objs.push({
          key: keyPrefix + item.field,
          value: item.data
        })
      }
      break
    default:
      obj.key = 'txt_' + item.field
      obj.value = item.data
      objs.push(obj)
  }

  return objs
}

// 搜索建议处理函数
const handleSuggestions = (queryString: string, cb: (suggestions: any[]) => void, item: any) => {
  // 根据输入项的配置提供搜索建议
  const suggestions = []

  if (item.suggestions && Array.isArray(item.suggestions)) {
    // 如果配置了建议项，进行模糊匹配
    const filtered = item.suggestions.filter((suggestion: any) => {
      return suggestion.value.toLowerCase().includes(queryString.toLowerCase())
    })
    suggestions.push(...filtered)
  } else {
    // 默认建议（可以根据字段类型提供不同的建议）
    const defaultSuggestions = getDefaultSuggestions(item.field, queryString)
    suggestions.push(...defaultSuggestions)
  }

  cb(suggestions)
}

// 获取默认搜索建议
const getDefaultSuggestions = (field: string, queryString: string) => {
  const suggestions: { value: string }[] = []

  // 根据字段类型提供不同的默认建议
  if (field === 'username' || field === 'applicant' || field === 'creator') {
    // 人名建议
    const nameList = ['张三', '李四', '王五', '赵六', '陈七', '周八', '吴九', '郑十']
    nameList.forEach((name) => {
      if (!queryString || name.includes(queryString)) {
        suggestions.push({ value: name })
      }
    })
  } else if (field === 'projectno' || field === 'taskno' || field === 'orderid') {
    // 编号建议
    const prefixes = ['PRJ', 'TASK', 'ORD', 'REQ']
    prefixes.forEach((prefix) => {
      for (let i = 1; i <= 3; i++) {
        const value = `${prefix}${new Date().getFullYear()}${String(i).padStart(3, '0')}`
        if (!queryString || value.toLowerCase().includes(queryString.toLowerCase())) {
          suggestions.push({ value })
        }
      }
    })
  }

  return suggestions.slice(0, 8) // 限制建议数量
}

// 监听容器大小变化
onMounted(async () => {
  registerGlobalClick()
  loadFilterConfig() // 加载筛选配置
  await getLabelData()

  if (conditionsContainer.value) {
    const erd = elementResizeDetectorMaker()
    erd.listenTo(conditionsContainer.value, (element) => {
      containerWidth.value = element.offsetWidth
    })
  }
})

onUnmounted(() => {
  // 组件卸载时取消注册全局点击事件
  unregisterGlobalClick()
})

// 监听筛选数据变化
watch(
  () => props.filterData,
  (val) => {
    // 确保range类型数据有正确的初始结构
    myFilterData.value = JSON.parse(JSON.stringify(val)).map((item) => {
      if (item.type === 'el-input-range' && (!item.data || typeof item.data !== 'object')) {
        item.data = { start: '', end: '' }
      }
      return item
    })

    // 如果配置未初始化或filterData变化，重新初始化配置
    if (
      filterConfig.value.commonFilters.length === 0 &&
      filterConfig.value.uncommonFilters.length === 0
    ) {
      loadFilterConfig()
    }
  },
  { deep: true, immediate: true }
)

// 监听标签ID变化
watch(
  selectedTagIds,
  (newIds) => {
    tempSelectedTags.value = labelList.value.filter((item) => newIds.includes(item.id))
  },
  { deep: true }
)

// 计算是否有激活的筛选条件
const hasActiveFilters = computed(() => {
  return selectedTags.value.length > 0 || selectedConditions.value.length > 0
})

// 计算总筛选条件数量
const totalFilterCount = computed(() => {
  return selectedTags.value.length + selectedConditions.value.length
})

// 添加按钮点击处理函数
const handleButtonClick = (e) => {
  e.stopPropagation() // 阻止事件冒泡
  popoverVisible.value = !popoverVisible.value

  // 初始化临时状态
  if (popoverVisible.value) {
    tempSelectedTags.value = [...selectedTags.value]
    selectedTagIds.value = selectedTags.value.map((tag) => tag.id)

    // 确保默认选择第一个可用的类别（优先选择常用筛选）
    const firstAvailableCategory = filterCategories.value[0]
    if (firstAvailableCategory) {
      activeCategory.value = firstAvailableCategory.key
    } else {
      activeCategory.value = 'common' // 默认选择常用筛选
    }
  }
}

// 添加标签区域的折叠状态
const labelSectionVisible = ref(false)

// 切换标签区域的显示/隐藏
const toggleLabelSection = () => {
  labelSectionVisible.value = !labelSectionVisible.value
}
</script>

